# JustaPDF production environment
NODE_ENV=production
APP_URL=https://justapdf.com
HOST=127.0.0.1
PORT=3000
CORS_ORIGIN=https://justapdf.com

# YAHBASE PostgreSQL connection. DATABASE_URL is canonical; the alias is
# accepted for runtimes that expose the YAHBASE connection under that name.
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/justapdf
DATABASE_SSL=false
DB_POOL_MAX=10
STORAGE_ROOT=/var/lib/justapdf/storage

# Authentication and first-admin bootstrap. Generate a long random JWT_SECRET.
JWT_SECRET=replace-with-a-long-random-secret
SUPRA_ADMIN_EMAIL=admin@example.com
ROOT_PASSWORD=replace-with-a-long-random-password

# Optional integrations
OPENAI_API_KEY=
AI_CONTRACT_MODEL=gpt-4o-mini
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
NATIVE_EDIT_URL=http://127.0.0.1:8787
NATIVE_EDIT_ENGINE=glyph
NATIVE_EDIT_VALIDATE_PDFIUM=false
