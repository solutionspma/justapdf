{
  "name": "justa-pdf",
  "version": "1.0.0",
  "description": "JustaPDF - Complete PDF Suite with AI, Blockchain Signatures, and Design Tools",
  "type": "module",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "build": "echo 'Static frontend - no build required'",
    "build:editor": "cd pdf-power-editor && npm install && npm run build && mkdir -p ../public/editor && cp -r dist/* ../public/editor/",
    "db:migrate": "node scripts/migrate.js",
    "db:check": "node scripts/db-check.js",
    "test": "node --test --test-reporter spec",
    "lint": "eslint ."
  },
  "keywords": [
    "pdf",
    "document",
    "signature",
    "e-signature",
    "blockchain",
    "ai",
    "contract",
    "design",
    "web3"
  ],
  "author": "Pitch Marketing Agency",
  "license": "PROPRIETARY",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.20.1",
    "pg": "^8.16.3",
    "pdf-lib": "^1.17.1",
    "pdfcpu-wasm": "^0.1.0",
    "sharp": "^0.33.0",
    "stripe": "^14.7.0",
    "uuid": "^9.0.1",
    "web3": "^4.2.2"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pitchmarketingagency/justa-pdf.git"
  },
  "homepage": "https://justapdf.app",
  "bugs": {
    "url": "https://github.com/pitchmarketingagency/justa-pdf/issues"
  }
}
